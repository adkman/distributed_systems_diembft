import os

from client import Client
from cryptography import Cryptography
from logger_util import Logging
from object_types import FailType, Failure, FailureConfig, MsgType
from validator import Validator, ValidatorFI

# from validator_fi import ValidatorFI


class RunDiemBFT(process):

    def setup(config):
        self.nvalidators = int(config['nvalidators'])
        self.nclients = int(config['nclients'])
        self.nfaulty = int(config['nfaulty'])

    def run():

        private_keys_validators = {}
        public_keys_validators = {}
        private_keys_clients = {}
        public_keys_clients = {}

        if not os.path.exists('./logs'):
            os.makedirs('./logs')
        if not os.path.exists('./ledgers'):
            os.makedirs('./ledgers')

        nloyalvalidators = nvalidators - nfaulty
        loyal_validators = new(Validator, num=nloyalvalidators)
        faulty_validators = new(ValidatorFI, num=nfaulty)
        validators = list(loyal_validators) + list(faulty_validators)
        clients = new(Client, num=nclients)

        for v in validators:
            private_key, public_key = Cryptography.generate_key()
            private_keys_validators[v] = private_key
            public_keys_validators[v] = public_key

        for c in clients:
            private_key, public_key = Cryptography.generate_key()
            private_keys_clients[c] = private_key
            public_keys_clients[c] = public_key

        for i, v in enumerate(validators):
            setup({v}, (config, i, validators, list(clients),
                        private_keys_validators[v], public_keys_validators, public_keys_clients))

        for i, c in enumerate(clients):
            setup({c}, (config, i, validators,
                        private_keys_clients[c], public_keys_validators))

        start(validators)
        start(clients)

        await(each(c in clients, has=received(('Done',), from_=c)))
        output("All clients done, informing all validators.")
        send(('Done',), to=validators)


def is_config_valid(config):
    if int(config['nvalidators']) < (3 * int(config['nfaulty']) + 1):
        output(
            "Number of validators should be more than thrice of number of faulty validators.")
        return False
    if (int(config['nfaulty']) > int(config['exclude_size'])) or (int(config['exclude_size']) > 2 * int(config['nfaulty'])):
        output(
            "Exlude size should be between nfaulty and 2*nfaulty")
        return False
    return True


def main():
    configs = [{
        'nvalidators': 5,
        'nfaulty': 1,
        'nclients': 5,
        'nclientops': 5,
        'sleeptime': 1,
        'clienttimeout': 10,
        'delta': 5,
        'window_size': 5,
        'exclude_size': 1,
        'failure_config': FailureConfig(
            failures=[
                Failure(src='_', dest='leader', msg_type=MsgType.Vote,
                        round=1, prob=1, fail_type=FailType.Delay, val=0.1, attr=None),
                Failure(src='_', dest='_', msg_type=MsgType.Vote,
                        round=3, prob=1, fail_type=FailType.MsgLoss, val=None, attr=None),
                Failure(src='leader', dest='_', msg_type=MsgType.Vote, round=3,
                        prob=0.5, fail_type=FailType.SetAttr, val=2, attr='highest_vote_round')
            ],
            seed=12345678
        )
    }]
    for config in configs:
        if not is_config_valid(config):
            output("The provided config", config,
                   "is not valid. Skipping this config.")
            continue
        p = new(RunDiemBFT)
        setup(p, (config,))
        start(p)
    output("All configs executed!")
