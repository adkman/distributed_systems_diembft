from logger_util import Logging

class MemPool:

    def __init__(self, validator_id):
        self.pending_txns = dict()
        self.validator_id = validator_id

    def add_transaction(self, txn):
        Logging.log('MemPool: add_transaction', txn)
        if (txn['req_id'] not in self.pending_txns):
            self.pending_txns[txn['req_id']] = txn
    
    def peek_pool(self):
        Logging.log('MemPool: peek_pool', None)
        length = len(self.pending_txns.keys())
        Logging.log('MemPool: peek_pool: returns', length, self.pending_txns.keys())
        return length

    def get_transactions(self):
        Logging.log('MemPool: get_transactions', None)
        # send_txns = list(self.pending_txns.values())
        # self.pending_txns.clear()
        if len(self.pending_txns) == 0:
            Logging.log('MemPool: get_transactions: returns', [])
            return []
        keys = list(self.pending_txns.keys())
        send_txns = [self.pending_txns[keys[0]]]
        del self.pending_txns[keys[0]]
        Logging.log('MemPool: get_transactions: returns', send_txns)
        return send_txns

    def validate_and_remove_transactions(self, txns):
        Logging.log('MemPool: validate_and_remove_transactions', txns)
        to_remove = []
        for txn in txns:
            if txn['req_id'] in self.pending_txns:
                to_remove.append(txn['req_id'])
            else:
                Logging.log('MemPool: validate_and_remove_transactions: returns', False)
                return False

        for req_id in to_remove:
            del self.pending_txns[req_id]
        Logging.log('MemPool: validate_and_remove_transactions: returns', True)
        return True


def main():
    mempool = MemPool()
    mempool.add_transaction({'req_id': 1, 'command': "sss"})
    mempool.add_transaction({'req_id': 1, 'command': "ttt"})
    mempool.add_transaction({'req_id': 2, 'command': "ppp"})
    print(mempool.get_transactions())
    print(mempool.get_transactions())
