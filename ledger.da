from os import spawnle

from cryptography import Cryptography
from logger_util import Logging


class Ledger:

    def __init__(self, config_id, validator_id, id_block, recently_committed_block_ids, request_cache):
        self.validator_id = validator_id
        self.config_id = config_id
        self.state_id = 0
        self.block_id_to_state_id = dict()
        self.recently_committed_block_ids = recently_committed_block_ids
        self.speculate_tree = dict()
        self.commited = dict()
        self.genesis = "Genesis"
        self.id_to_block = id_block
        self.request_cache = request_cache
        self.filename = "validator_" + str(validator_id) + ".ledger"
        fp = open('./ledgers/config' + str(config_id) +
                  "/" + self.filename, 'w')
        fp.close()

    def get_state_id(self, prev_block_id=None, block_id=None, txns=None):
        Logging.log('Ledger: get_state_id', prev_block_id, block_id, txns)
        if prev_block_id == None:
            new_state_id = Cryptography.hash(txns)
            Logging.log('Ledger: get_state_id: returns', new_state_id)
            return new_state_id

        parent_state_id = self.block_id_to_state_id[prev_block_id]
        new_state_id = Cryptography.hash(parent_state_id, txns)
        Logging.log('Ledger: get_state_id: returns', new_state_id)
        return new_state_id

    def speculate(self, prev_block_id, block_id, txns):
        Logging.log('Ledger: speculate', prev_block_id, block_id, txns)
        if prev_block_id == None:
            # self.speculate_tree[self.genesis] = [block_id]
            self.speculate_tree[block_id] = []

        elif prev_block_id not in self.speculate_tree:
            print("SPEC ERROR")

        else:
            self.speculate_tree[prev_block_id].append(block_id)
            self.speculate_tree[block_id] = []
            # state_id = self.get_state_id()
            # self.block_id_to_state_id[prev_block_id] = state_id

        state_id = self.get_state_id(prev_block_id, block_id, txns)
        self.block_id_to_state_id[block_id] = state_id

        # fp = open('./ledgers/' + 'SpecTree' + self.filename,'a+')
        # fp.write(str(self.speculate_tree))
        # fp.write('\n')
        # fp.close()

    def pending_state(self, block_id):
        Logging.log('Ledger: pending_state', block_id)
        if block_id in self.block_id_to_state_id:
            pending_state = self.block_id_to_state_id[block_id]
            Logging.log('Ledger: pending_state: returns', pending_state)
            return pending_state
        Logging.log('Ledger: pending_state: returns', None)
        return None

    def commit(self, block_id):
        Logging.log('Ledger: commit', block_id)
        if block_id not in self.id_to_block:
            Logging.log('Ledger: commit: did not commit', None)
            return
        recently_commited = set()
        current_block_to_commit = self.id_to_block[block_id]
        stack = []
        while(current_block_to_commit.id not in self.commited):
            # self.commited[current_block_to_commit.id] = current_block_to_commit.payload
            if current_block_to_commit.id not in self.id_to_block:
                break
            stack.append((current_block_to_commit.id,
                          current_block_to_commit.payload))
            recently_commited.add(current_block_to_commit.id)

            # Pruning Logic
            # prev_commited_block_id = current_block_to_commit.id
            #

            # Now check if the current block has a QC
            if current_block_to_commit.qc == None or current_block_to_commit.qc.vote_info.id not in self.id_to_block:
                break
            current_block_to_commit = self.id_to_block[current_block_to_commit.qc.vote_info.id]
            # current_block_to_commit = self.id_to_block[current_block_to_commit.qc]

            # Pruning Logic
            # parent = current_block_to_commit.id
            # if len(self.speculate_tree[parent]) > 1:
            #     self.speculate_tree[parent] = [prev_commited_block_id]
        # if len(recently_commited) > 0:
        #     file = open('./ledgers/' + 'PrunedSpecTree' + self.filename,'a+')
        #     file.write('\n')
        #     file.write("commited" + str(recently_commited))
        #     file.write("\n")
        #     block = self.id_to_block[block_id]
        #     prev_block = block.qc
        #     if prev_block != None:
        #         file.write("Parent is ")
        #         prev_block = prev_block.vote_info.id
        #         file.write(str(prev_block)+'\n')
        #     else:
        #         file.write("No parent")
        #     file.close()

        fp = open('./ledgers/config' + str(self.config_id) +
                  "/" + self.filename, 'a+')
        while(stack):
            block_id, payload = stack.pop()
            self.commited[block_id] = payload
            for txn in payload:
                if txn['req_id'] in self.request_cache:
                    Logging.log(
                        'Ledger: commit skipping txn as already committed', txn)
                    continue
                else:
                    Logging.log('Ledger: commit committing a txn', txn)
                    fp.write(txn['command']+'\n')
            self.recently_committed_block_ids.append(block_id)
            Logging.log('Ledger: commit recent_committed_blocks',
                        self.recently_committed_block_ids)
        fp.close()

        Logging.log('Ledger: commit: ends', None)
        # if len(recently_commited) > 0:
        #     file = open('./ledgers/' + 'PrunedSpecTree' + self.filename,'a+')
        #     file.write("\n"+str(self.speculate_tree))
        #     file.close()

        # Pruning the SpeculateTree
        if block_id not in self.id_to_block:
            print("----------------------------------------------------------")
            return
        block = self.id_to_block[block_id]
        prev_block = block.qc
        if prev_block != None:
            prev_block = prev_block.vote_info.id
            if prev_block in self.speculate_tree:
                for i in self.speculate_tree[prev_block]:
                    if i != block_id:
                        if i in self.speculate_tree:
                            del self.speculate_tree[i]
                self.speculate_tree[prev_block] = [block_id]
                del self.speculate_tree[prev_block]
                # self.speculate_tree[prev_block] = [block_id]
                # del self.speculate_tree[prev_block]

        for i in self.recently_committed_block_ids:
            if i == block_id:
                continue
            if i in self.speculate_tree:
                for j in self.speculate_tree[i]:
                    if j in self.speculate_tree and j != block_id:
                        del self.speculate_tree[j]
                if i in self.speculate_tree:
                    del self.speculate_tree[i]

        # if len(recently_commited) > 0:
        #     file = open('./ledgers/' + 'PrunedSpecTree' + self.filename,'a+')
        #     file.write(str(self.speculate_tree)+'\n')
        #     file.close()

    def committed_block(self, block_id):
        Logging.log('Ledger: committed_block', block_id)
        if block_id in self.commited:
            commited_block = self.id_to_block[block_id]
            Logging.log('Ledger: committed_block: returns', commited_block)
            return commited_block
        Logging.log('Ledger: committed_block: returns', None)
        return None


def main():
    l = Ledger(1, 2, 3)
