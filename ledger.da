# from collections import DefaultDict


class Ledger:

    def __init__(self):
        self.state_id = 0
        # self.spec_tree = DefaultDict(DefaultDict())
        self.spec_tree = dict()
        self.state_id_map = dict()
        self.pend_state = dict()

    def speculate(self,prev_block_id, block_id, txns):
        if prev_block_id not in self.state_id_map:
            self.state_id_map[prev_block_id] = 0
        self.state_id += 1
        self.state_id_map[block_id] = self.state_id
        # self.spec_tree[self.state_id_map[prev_block_id]][self.state_id_map[block_id]] = txns
        if self.state_id_map[prev_block_id] not in self.spec_tree:
            self.spec_tree[self.state_id_map[prev_block_id]] = {self.state_id_map[block_id]:txns}
        else:
            self.spec_tree[self.state_id_map[prev_block_id]][self.state_id_map[block_id]] = txns 
        self.pend_state[self.state_id] = self.state_id_map[prev_block_id]
        
    def pending_state(self,block_id):
        if block_id in self.pend_state:
            self.pend_state[block_id]
        return None

    def commit(self,block_id):
        pend = self.pend_state[block_id] # gets the state ID of parent
        print(self.spec_tree[pend][self.state_id_map[block_id]])
        #prune
        # for i in self.spec_tree

