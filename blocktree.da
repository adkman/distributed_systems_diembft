# from 
class BlockTree:
    def __init__(self):
        pending_block_tree = [] # tree of blocks pending commitment
        pending_votes = None # collected votes per block indexed by their LedgerInfo hash
        high_qc = None # highest known QC
        high_commit_qc = None # highest QC that serves as a commit certificate

    def execute_and_insert(self,b):
        Ledger.speculate(b.qc.block_id, b.id, b.payload)
        self.pending_block_tree.add(b)

    def generate_block(self,txns, current_round):
        return Block(
            author = u,
            round = current_round,
            payload = txns,
            qc = high_qc,
            #id = hash(author || round || payload || qc.vote info.id || qc.signatures) 
            )

    def process_vote(self,v):
        self.process_qc(v.high_commit_qc)
        vote_idx = hash(v.ledger_commit_info)
        self.pending_votes[vote_idx] = self.pending_votes[vote_idx].add(v.signature)
        if len(self.pending_votes[vote_idx]) == 2*f + 1:
            qc = QC(
            vote_info = v.vote_info,
            state_id = v.state_id,
            votes = self.pending_votes[vote_idx]
            )
            return qc
        return None

    def process_qc(self,qc):
        if qc.ledger_commit_info.commit_state_id != None:
            Ledger.commit(qc.vote_info.parent_id)
            self.pending_block_tree.prune(qc.vote_info.parent_id) # parent id becomes the new root of pending
            #high_commit_qc = maxround{qc, high_x_qc}
            self.high_commit_qc = max(qc, self.high_commit_qc)
        self.high_qc = max(qc, self.high_qc)

