from object_types import TC, TimeoutMsg
from logger_util import Logging
import threading
from block_tree import BlockTree


class Pacemaker:

    def __init__(self, validator_id, replicas, blocktree, safety, nfaulty, delta, send_timeout_msg):
        self.current_round = 1  # Initially zero
        self.last_round_tc = None  # Initially None
        self.pending_timeouts = dict()  # Timeouts per rounda
        self.f = nfaulty
        self.delta = delta
        self.validator = replicas[validator_id]
        self.validator_id = validator_id
        self.blocktree = blocktree
        self.safety = safety
        self.timer = None
        self.replicas = replicas
        self.send_timeout_msg = send_timeout_msg
        self.tmo_senders = dict()

    def get_round_timer(self, r):
        Logging.log('Pacemaker: get_round_timer', r)
        # TODO: Can modify formula if wanted
        return 4*self.delta

    def stop_timer(self, round):
        Logging.log('Pacemaker: stop_timer', round)
        if self.timer is not None:
            self.timer.cancel()

    # TODO: Read "Questions regarding MemPool Implementation" on Blackboard Discussion
    def start_timer(self, new_round):
        Logging.log('Pacemaker: start_timer', new_round)
        self.stop_timer(self.current_round)
        self.current_round = new_round
        self.timer = threading.Timer(self.get_round_timer(
            new_round), self.local_timeout_round)
        self.timer.start()

    def local_timeout_round(self):
        Logging.log('Pacemaker: local_timeout_round', [])
        timeout_info = self.safety.make_timeout(
            self.current_round, self.blocktree.high_qc, self.last_round_tc)
        # TODO: How to broadcast? Need to make PaceMaker as a process???
        # TODO: private_key, replicas is not there with Pacemaker, MERGE with validator

        timeout_msg = TimeoutMsg(
            timeout_info, self.last_round_tc, self.blocktree.high_commit_qc)
        Logging.log("Timeout Msg parameters", timeout_info,
                    self.last_round_tc, self.blocktree.high_commit_qc)
        self.send_timeout_msg(timeout_msg)

    def process_remote_timeout(self, tmo):
        Logging.log('Pacemaker: process_remote_timeout', tmo)
        # print("Content", tmo.tmo_info, tmo.tmo_info.__dict__)
        tmo_info = tmo.tmo_info
        if tmo_info.round < self.current_round:
            Logging.log('Pacemaker: process_remote_timeout: returns', None)
            return None
        if tmo_info.round not in self.pending_timeouts:
            self.pending_timeouts[tmo_info.round] = set()
            self.tmo_senders[tmo_info.round] = set()
        # if tmo_info.author not in self.pending_timeouts[tmo_info.round].senders:
        if tmo_info.author not in self.tmo_senders[tmo_info.round]:
            self.tmo_senders[tmo_info.round].add(tmo_info.author)

            # TODO: In pending_timeouts dictionary, for given key round number what is the corresponding value?
            self.pending_timeouts[tmo_info.round].add(
                tmo_info)
        # if len(self.pending_timeouts[tmo_info.round].senders) == self.f + 1:
        if len(self.tmo_senders[tmo_info.round]) == self.f + 1:
            self.stop_timer(self.current_round)
            self.local_timeout_round()  # Bracha timeout
        # if len(self.pending_timeouts[tmo_info.round].senders) == 2*self.f + 1:
        if len(self.tmo_senders[tmo_info.round]) == 2*self.f + 1:
            # print("Entering here")
            # tmo_high_qc_rounds = set([t.high_qc.round for t in self.pending_timeouts[tmo_info.round]])
            tmo_high_qc_rounds = set()
            for t in self.pending_timeouts[tmo_info.round]:
                if t.high_qc != None:
                    tmo_high_qc_rounds.add(t.high_qc.vote_info.round)
                else:
                    tmo_high_qc_rounds.add(0)

            # signatures = set([t.signature for t in self.pending_timeouts[tmo_info.round]])
            signatures = set()
            for t in self.pending_timeouts[tmo_info.round]:
                signatures.add(t.author)

            tc = TC(tmo_info.round, tmo_high_qc_rounds,
                    signatures, self.validator_id)
            Logging.log('Pacemaker: process_remote_timeout: returns', tc)
            print("Exited with TC")
            return tc
        Logging.log('Pacemaker: process_remote_timeout: returns', None)
        print("Exited without TC")
        return None

    def advance_round_tc(self, tc):
        Logging.log('Pacemaker: advance_round_tc', tc)
        if tc == None or tc.round < self.current_round:
            Logging.log('Pacemaker: advance_round_tc: returns', False)
            return False
        last_round_tc = tc
        self.start_timer(tc.round + 1)
        Logging.log('Pacemaker: advance_round_tc: returns', True)
        return True

    def advance_round_qc(self, qc):
        Logging.log('Pacemaker: advance_round_qc', qc)
        if qc is None:
            Logging.log('Pacemaker: advance_round_qc: returns', True)
            return True
        if qc.vote_info.round < self.current_round:
            Logging.log('Pacemaker: advance_round_qc: returns', False)
            return False
        self.last_round_tc = None
        self.start_timer(qc.vote_info.round + 1)
        Logging.log('Pacemaker: advance_round_qc: returns', True)
        return True
