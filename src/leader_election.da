import random

from logger_util import LOGGER


class LeaderElection:

    def __init__(self, round_to_leader):
        '''validators; // The list of current validators'''
        self.round_to_leader = round_to_leader

    '''Function get leader(round)'''

    def get_leader(self, round):
        if len(self.round_to_leader) > round:
            return self.round_to_leader[round]
        else:
            return 0
