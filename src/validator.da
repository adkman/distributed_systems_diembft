import collections

from block_tree import BlockTree
from cryptography import Cryptography
from leader_election import LeaderElection
from ledger import Ledger
from logger_util import LOGGER
from mem_pool import MemPool
from object_types import ProposalMsg
from pacemaker import Pacemaker
from safety import Safety
from utils import todict


class Validator (process):

    def setup(
        config,
        config_id: int,
        validator_id: int,
        uniq_vid,
        replicas: list,
        private_key,
        public_keys_validators,
        round_to_leader,
        test_executor_id,
        proc_to_uid,
        network_playground
    ):

        LOGGER.process_id = "validator_" + str(validator_id)
        LOGGER.filename = '../logs/config' + str(config_id) + '/' + str(test_executor_id) + '/' \
            + "validator_" + str(uniq_vid)  # + ".log"
        if uniq_vid > validator_id:
            LOGGER.filename += "_TwinOf_" + str(validator_id)
        LOGGER.filename += ".log"

        LOGGER.log_action("Initial configuration", config)

        self.id_block = dict()
        self.request_cache = dict()
        self.recently_committed_block_ids = list()
        self.round_to_leader = round_to_leader
        self.uniq_vid = uniq_vid
        self.proc_to_uid = proc_to_uid
        self.should_start_new_round = True
        self.proposal_msg_cache = dict()
        self.proposed_msg_block_ids = set()
        self.recently_received_proposal = None
        self.commit_idx = 0

        self.ledger = Ledger(
            config_id, validator_id, self.id_block,
            self.recently_committed_block_ids, self.request_cache,
            test_executor_id, uniq_vid
        )
        self.blocktree = BlockTree(
            validator_id, replicas, self.ledger, config['nfaulty'], self.id_block)
        self.safety = Safety(validator_id, replicas,
                             self.ledger, self.blocktree)
        self.pacemaker = Pacemaker(
            validator_id, replicas, self.blocktree, self.safety,
            config['nfaulty'], config['delta'], send_timeout_msg
        )
        self.mempool = MemPool(uniq_vid, self.pacemaker)
        self.leader_election = LeaderElection(round_to_leader)
        self.tc_cache = dict()

        self.syncingup = False
        self.issendingsync = False

        Cryptography.private_key = self.private_key
        Cryptography.proc_to_uid = self.proc_to_uid
        Cryptography.replicas = self.replicas
        Cryptography.public_keys_validators = self.public_keys_validators

    '''Procedure start event processing(M)'''
    def run():
        self.pacemaker.start_timer(1)
        LOGGER.log(replicas[validator_id])
        process_new_round_event(None)
        await(received(('Done',), from_=parent()))
        await(self.syncingup == False)
        await(self.issendingsync == False)
        self.pacemaker.stop_timer(self.pacemaker.current_round)
        output("Validator", self.validator_id, "is exiting")

    # Broadcast the timeout message
    def send_timeout_msg(timeout_msg):
        LOGGER.log('Validator: send_timeout_message', timeout_msg)
        send(('Timeout', timeout_msg, [x for x in range(config['nvalidators'])],
              self.pacemaker.current_round), to=network_playground)
        LOGGER.log_event('Sent', 'Timeout', timeout_msg, self.replicas)

    '''Procedure process certificate qc(qc)'''
    def process_certificate_qc(qc):
        LOGGER.log('Validator: process_certificate_qc', qc)

        '''Block-Tree.process qc(qc)'''
        self.blocktree.process_qc(qc)

        LOGGER.log('Validator: process_certificate_qc recent_committed_block', len(
            self.recently_committed_block_ids))
        # Send responses to the requests which were recently committed
        if len(self.recently_committed_block_ids) > 0:
            for block_id in self.recently_committed_block_ids:
                idx = self.commit_idx
                self.commit_idx += 1
                block_committed = self.id_block[block_id]
                curr_round = self.pacemaker.current_round
                send(('CommitAck', idx, block_committed,
                     curr_round, ), to=network_playground)
            self.recently_committed_block_ids.clear()

        '''LeaderElection.update leaders(qc)'''
        # self.leader_election.update_leaders(qc)

        '''Pacemaker.advance round(qc.vote info.round)'''
        self.pacemaker.advance_round_qc(qc)

        LOGGER.log('Validator: process_certificate_qc ended', qc)

    '''Procedure process new round event(last tc)'''
    def process_new_round_event(last_tc):
        LOGGER.log('Validator: process_new_round_event', last_tc)

        '''if u = LeaderElection.get leader(Pacemaker.current round) then'''
        if validator_id == self.leader_election.get_leader(self.pacemaker.current_round):

            '''b ← Block-Tree.generate block( MemPool.get transactions(),
                    Pacemaker.current round )'''
            block = self.blocktree.generate_block(
                self.mempool.get_transactions(), self.pacemaker.current_round)
            LOGGER.log_action('Created a new block', block)

            '''broadcast ProposalMsghb, last tc, Block-Tree.high commit qci'''
            proposal_msg = ProposalMsg(
                block=block,
                last_round_tc=last_tc,
                high_commit_qc=self.blocktree.high_commit_qc,
                validator=validator_id
            )

            self.proposed_msg_block_ids.add(proposal_msg.block.id)

            if proposal_msg.block.round not in self.proposal_msg_cache:
                self.proposal_msg_cache[proposal_msg.block.round] = proposal_msg

            if True:
                # if self.pacemaker.current_round != 5 and self.pacemaker.current_round != 6:
                send(('Proposal', proposal_msg, [x for x in range(config['nvalidators'])],
                      self.pacemaker.current_round), to=network_playground)
                LOGGER.log_event("Sent", "Proposal",
                                 proposal_msg, self.replicas)

        LOGGER.log("Validator: process_new_round_event ends", None)

    '''Procedure process proposal msg(P)'''
    def receive(msg=('Proposal', proposal_msg, src_vid), from_=p):

        LOGGER.log_event("Received", "Proposal", proposal_msg, src_vid)

        signature_verified = Cryptography.get_verified_message(
            proposal_msg.signature, public_keys_validators[src_vid])

        if signature_verified is not None and Cryptography.verify_block_hash(proposal_msg.block):
            LOGGER.log_action("Verified ProposalMsg signature", True)
            self.recently_received_proposal = proposal_msg

            if self.syncingup == False:
                if True:
                    if proposal_msg.block.round not in self.proposal_msg_cache:
                        self.proposal_msg_cache[proposal_msg.block.round] = proposal_msg

                    if proposal_msg.block.qc is not None and proposal_msg.block.qc.vote_info.id not in self.id_block:
                        self.syncingup = True
                        send(('sync_up_request', {"round": self.pacemaker.current_round,
                              "to_round": proposal_msg.block.round, "send_to": proposal_msg.sender, "from": self.validator_id, "proposal_msg": proposal_msg}), to=network_playground)
                        await(proposal_msg.block.qc.vote_info.id in self.id_block)
                        self.syncingup = False

                    if proposal_msg.block.qc is not None and src_vid != validator_id:

                        '''process certificate qc(P.block.qc)'''
                        process_certificate_qc(proposal_msg.block.qc)

                    if proposal_msg.high_commit_qc is not None:
                        '''process certificate qc(P.high commit qc)'''
                        process_certificate_qc(proposal_msg.high_commit_qc)

                    '''Pacemaker.advance round tc(P.last round tc)'''
                    self.pacemaker.advance_round_tc(proposal_msg.last_round_tc)

                    '''round ← Pacemaker.current round'''
                    round = self.pacemaker.current_round
                    '''leader ← LeaderElection.get leader(current round)'''
                    leader = self.leader_election.get_leader(round)
                    '''if P.block.round 6= round ∨ P.sender 6= leader ∨ P.block.author 6= leader then
                            return'''
                    if proposal_msg.block.round != round or self.proc_to_uid[replicas[proposal_msg.sender]] != leader or self.proc_to_uid[replicas[proposal_msg.block.author]] != leader:
                        LOGGER.log("ROUND PROPOSAL EARLY EXIT", proposal_msg.block.round,
                                   round, replicas[proposal_msg.sender], leader)
                        return

                    '''Block-Tree.execute and insert(P) // Adds a new speculative state to the Ledger'''
                    self.blocktree.execute_and_insert(proposal_msg.block)

                    while self.pacemaker.current_round < self.recently_received_proposal.block.round:
                        self.syncingup = True
                        proposal_msg = self.recently_received_proposal
                        send(('sync_up_request', {"round": self.pacemaker.current_round,
                              "to_round": proposal_msg.block.round+1, "send_to": proposal_msg.sender, "from": self.validator_id, "proposal_msg": proposal_msg}), to=network_playground)
                        await(self.pacemaker.current_round == proposal_msg.block.round)

                        self.syncingup = False

                    '''vote msg ← Safety.make vote(P.block, P.last round tc)'''
                    vote_msg = self.safety.make_vote(
                        proposal_msg.block, proposal_msg.last_round_tc)

                    '''if vote msg != ⊥ then
                            send vote msg to LeaderElection.get leader(current round + 1)'''
                    if vote_msg is not None:
                        next_leader = self.leader_election.get_leader(
                            round + 1)
                        send(('Vote', vote_msg, [next_leader],
                              self.pacemaker.current_round), to=network_playground)
                        LOGGER.log_event("Sent", "Vote", vote_msg, next_leader)
        else:
            LOGGER.log_action("Verified ProposalMsg signature", False)

    '''Procedure process vote msg(M)'''
    def receive(msg=('Vote', vote_msg, src_vid), from_=p):
        LOGGER.log_event("Received", "Vote", vote_msg, src_vid)

        signature_verified = Cryptography.get_verified_message(
            vote_msg.signature, public_keys_validators[src_vid])

        if signature_verified is not None and Cryptography.verify_vote_msg_hash(vote_msg):
            LOGGER.log_action("Verified VoteMsg signature", True)

            '''qc ← Block-Tree.process vote(M)'''
            qc = self.blocktree.process_vote(vote_msg)
            '''if qc != ⊥ then'''
            if qc is not None:
                LOGGER.log_action("Generated a Quorum Certificate", qc)
                '''process certificate qc(qc)
                process new round event(⊥)'''
                process_certificate_qc(qc)
                process_new_round_event(None)

        else:
            LOGGER.log_action("Verified VoteMsg signature", False)

        LOGGER.log("Received VoteMsg ends g", None)

    '''Procedure process timeout msg(M)'''
    def receive(msg=('Timeout', timeout_msg, src_vid), from_=p):
        LOGGER.log_event("Received", "Timeout", timeout_msg, src_vid)

        signature_verified = Cryptography.get_verified_message(
            timeout_msg.tmo_info.author_signature, public_keys_validators[src_vid])

        if not(self.pacemaker.current_round == timeout_msg.tmo_info.round):
            return

        if signature_verified is not None:
            LOGGER.log_action("Verified TimeoutMsg signature", True)

            '''process certificate qc(M.tmo info.high qc)
            process certificate qc(M.high commit qc)'''
            process_certificate_qc(timeout_msg.tmo_info.high_qc)
            process_certificate_qc(timeout_msg.high_commit_qc)

            '''Pacemaker.advance round tc(M.last round tc)'''
            self.pacemaker.advance_round_tc(timeout_msg.last_round_tc)

            '''tc ← Pacemaker.process remote timeout(M)'''
            tc = self.pacemaker.process_remote_timeout(timeout_msg)
            '''if tc != ⊥ then'''
            if tc is not None:
                self.tc_cache[self.pacemaker.current_round] = tc
                LOGGER.log_action("Generated a Timeout Certificate", tc)
                '''process certificate qc(qc)
                process new round event(⊥)'''
                self.pacemaker.advance_round_tc(tc)
                process_new_round_event(tc)
        else:
            LOGGER.log_action("Verified TimeoutMsg signature", False)

    def receive(msg=('sync_up_request', sync), from_=net):
        round = sync["round"]
        to_round = sync["to_round"]
        p = sync["from"]
        proposal_msg = sync["proposal_msg"]
        if proposal_msg.block.id not in self.proposed_msg_block_ids:
            return
        self.issendingsync = True
        for i in range(round, to_round):
            if i in self.proposal_msg_cache:
                send(('block_to_sync_up', {
                     "proposal_msg": self.proposal_msg_cache[i], "idx": i, "send_to": p, "from": self.validator_id},), to=network_playground)
                await(received(('One_block_done' + str(i) + '_' + str(p)), from_=network_playground))
            else:
                send(('incr_round', {
                     "round": i, "send_to": p, "from": self.validator_id}), to=network_playground)
                await(received(('Increment_done' + str(i) + '_' + str(p)), from_=network_playground))
        self.issendingsync = False

    def receive(msg=('incr_round', sync), from_=p):
        round_num = sync["round"]
        send_to = sync["from"]
        self.pacemaker.start_timer(round_num)
        send(('Increment_done' + str(round_num) + '_' +
             str(self.validator_id), {"send_to": send_to}), to=network_playground)

    def receive(msg=('block_to_sync_up', sync), from_=p):

        if self.syncingup == False:
            return

        proposal_msg = sync["proposal_msg"]
        i = sync["idx"]
        send_to = sync["from"]

        signature_verified = Cryptography.get_verified_message(
            proposal_msg.signature, public_keys_validators[proposal_msg.sender])

        if signature_verified is not None:
            LOGGER.log_action(
                "Verified block_to_sync_up's ProposalMsg signature", True)
            '''process certificate qc(P.block.qc)'''
            if proposal_msg.block.qc is not None:
                process_certificate_qc(proposal_msg.block.qc)
            if proposal_msg.high_commit_qc is not None:
                '''process certificate qc(P.high commit qc)'''
                process_certificate_qc(proposal_msg.high_commit_qc)

            '''Pacemaker.advance round tc(P.last round tc)'''
            self.pacemaker.advance_round_tc(proposal_msg.last_round_tc)
            self.proposal_msg_cache[proposal_msg.block.round] = proposal_msg

            '''round ← Pacemaker.current round'''
            round = self.pacemaker.current_round
            '''leader ← LeaderElection.get leader(current round)'''
            leader = self.leader_election.get_leader(round)
            '''if P.block.round 6= round ∨ P.sender 6= leader ∨ P.block.author 6= leader then
                    return'''

            if proposal_msg.block.round != round or self.proc_to_uid[replicas[proposal_msg.sender]] != leader or self.proc_to_uid[replicas[proposal_msg.block.author]] != leader:
                LOGGER.log("ROUND PROPOSAL EARLY EXIT", proposal_msg.block.round,
                           round, replicas[proposal_msg.sender], leader)
                return

            '''Block-Tree.execute and insert(P) // Adds a new speculative state to the Ledger'''
            self.blocktree.execute_and_insert(proposal_msg.block)

            send(('One_block_done' + str(i) + '_' + str(self.validator_id, ),
                 {"send_to": send_to}), to=network_playground)
