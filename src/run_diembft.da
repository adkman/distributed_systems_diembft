        #                         proc_to_vid, vid_to_proc, liveness_bound, curr_executor)


        # for i, v in enumerate(validators):
        #     setup({v}, (config, config_id, i, list(validators), list(clients),
        #                 private_keys_validators[v], public_keys_validators, public_keys_clients))
        for i, v in enumerate(validators):
            node = validators[i]
            print(node)
            vid = i%nvalidators
            setup({node}, (config, config_id, vid, list(validators), list(clients),
                        private_keys_validators[vid%nvalidators], public_keys_validators, public_keys_clients, round_to_leader, test_executor_id, i, proc_to_vid, vid_to_proc))

        # for i, c in enumerate(clients):
        #     setup({c}, (config, config_id, i, list(validators),
        #                 private_keys_clients[c], public_keys_validators))

        start(validators)
        # start(clients)

        # start(network_playground)

        # await(each(c in clients, has=received(('Done',), from_=c)))
        # output("All clients done, informing all validators.", config_id)
        # send(('Done',), to=validators)
        await(received(('Terminate',)))
        # if p == curr_executor:
        #     output("Received a Violations, letting all validators know")
        # else:
        output("Received terminate, informing all validators and network playground")
