def is_config_valid(config):
    if int(config['nvalidators']) < (3 * int(config['nfaulty']) + 1):
        print(
            "Number of validators should be more than thrice of number of faulty validators.")
        return False
    if (int(config['nfaulty']) > int(config['exclude_size'])) or (int(config['exclude_size']) > 2 * int(config['nfaulty'])):
        print(
            "Exlude size should be between nfaulty and 2*nfaulty")
        return False
    return True


def main():

    #Read test_generator_config
    

    # if os.path.exists('../logs/'):# and os.path.isdir('../logs/'):
    shutil.rmtree('../logs/', ignore_errors=True)

    # if os.path.exists('../ledgers/'):# and os.path.isdir('../ledgers/'):
    shutil.rmtree('../ledgers/', ignore_errors=True)

    if os.path.exists('../test_executor_configs/') and os.path.isdir('../test_executor_configs/'):
        shutil.rmtree('../test_executor_configs/', ignore_errors=True)

    os.makedirs('../test_executor_configs/')

    config_id = 0
    for config in test_generator_configs:
        # if not is_config_valid(config):
        #     output("The provided config", config,
        #            "is not valid. Skipping this config.")
        #     continue
        TestGenerator(  config['nvalidators'],
                        config['nfaulty'],
                        config['nrounds'],
                        config['leader_selection_type'],
                        config['step1_limit'],
                        config['step2_limit'],
                        config['step3_limit'],
                        config['enum_order'],
                        '../test_executor_configs/scenario_'+str(config_id)+".da",
                        config['number_of_partitions'],
                        config['maximum_messages_to_drop'])
        # f = open('scenario_'+config_id, 'r'):
        # lala = '../test_executor_configs/scenario_'+str(config_id)
        # print("Current working directory: {0}".format(os.getcwd()))
        lala = "scenario_0"
        lala = __import__("scenario_0")
        test_executor_config = getattr(lala, "test_executor_config")
        test_executor_id = 0
        for scenario in test_executor_config:
            p = new(TestExecutor)
            setup(p, (scenario, config, config_id,test_executor_id, p))
            start(p)

            test_executor_id += 1

        # for test_executor_config in 
