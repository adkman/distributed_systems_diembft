import os
import shutil
import sys

sys.path.append('../test_generator_config')
sys.path.append('../test_executor_configs')

from test_generator import TestGenerator
from test_executor import TestExecutor
from test_generator_config import test_generator_configs

def main():

    # Read test_generator_config

    # if os.path.exists('../logs/'):# and os.path.isdir('../logs/'):
    shutil.rmtree('../logs/', ignore_errors=True)

    # if os.path.exists('../ledgers/'):# and os.path.isdir('../ledgers/'):
    shutil.rmtree('../ledgers/', ignore_errors=True)

    # if os.path.exists('../test_executor_configs/') and os.path.isdir('../test_executor_configs/'):
    #     shutil.rmtree('../test_executor_configs/', ignore_errors=True)

    # os.makedirs('../test_executor_configs/')

    config_id = 0
    for config in test_generator_configs:
        # TestGenerator(config['nvalidators'],
        #               config['nfaulty'],
        #               config['nrounds'],
        #               config['leader_selection_type'],
        #               config['step1_limit'],
        #               config['step2_limit'],
        #               config['step3_limit'],
        #               config['step1_enum_order'],
        #               config['step2_enum_order'],
        #               config['step3_enum_order'],
        #               '../test_executor_configs/scenario_' +
        #               str(config_id)+".da",
        #               config['number_of_partitions'],
        #               config['maximum_messages_to_drop'])

        scenario_module = __import__("scenario_"+str(config_id))
        # scenario_module = __import__("scenario_random")
        test_executor_config = getattr(scenario_module, "test_executor_config")
        test_executor_id = 0
        for scenario in test_executor_config:
            executor = new(TestExecutor)
            setup({executor}, (scenario, config,
                               config_id, test_executor_id, executor))
            start(executor)

            test_executor_id += 1

        config_id += 1
