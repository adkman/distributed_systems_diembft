import time

from logger_util import LOGGER


class NetworkPlayground(process):

    def setup(config, round_config, proc_to_uid, vid_to_proc, liveness_bound, config_id, test_executor_id):

        LOGGER.filename = '../logs/config' + \
            str(config_id) + '/' + str(test_executor_id) + \
            '/' + 'network_playground.log'

        self.round_config = round_config
        self.proc_to_uid = proc_to_uid
        self.vid_to_proc = vid_to_proc
        self.count_terminal_round_messages = set()
        self.commit_tracker = dict()  # <round, commit_acks[]>
        self.recent_committed_blocks_proposed_round = 0
        # liveness property is violated if there is no commit for proposal in liveness_bound number of rounds
        self.liveness_bound = liveness_bound
        self.config = config
        self.timeout_drop_count = dict()  # <round, dict()<uid, count>>

    def run():
        start = time.time()
        LOGGER.log_action("Scenario configuration", self.round_config)
        await(received(('Done',), from_=parent()))
        output('Exiting network playground')
        end = time.time()
        LOGGER.log_action("Elapsed time for this scenario",
                          str(end - start) + ' s')

    def get_current_config(curr_round):
        if curr_round < len(self.round_config):
            return self.round_config[curr_round]
        else:
            return {
                'partition': [[v for v in range(self.config['nvalidators'] + self.config['nfaulty'])]],
                'msg_drops': [[]],
                'Leader': 0,
            }

    def get_partition(current_partitions, uid):
        for idx in range(len(current_partitions)):
            if uid in current_partitions[idx]:
                return idx
        return None

    def drop_message(drop_configs, src_vid, msgType, curr_round):
        for drop_config in drop_configs:
            if drop_config['validator'] != src_vid:
                continue
            if drop_config['msgType'] == 'Timeout' and msgType == 'Timeout':
                if curr_round not in self.timeout_drop_count:
                    self.timeout_drop_count[curr_round] = {src_vid: 1}
                elif src_vid not in self.timeout_drop_count[curr_round]:
                    self.timeout_drop_count[curr_round][src_vid] = 1
                else:
                    if self.timeout_drop_count[curr_round][src_vid] >= self.config['timeout_max_drop_count']:
                        continue
                    else:
                        self.timeout_drop_count[curr_round][src_vid] += 1
            elif drop_config['msgType'] != msgType:
                continue
            LOGGER.log_network_event(curr_round, msgType, [
                                     'Message was dropped'])
            return True
        return False

    def relay_msg(msgType, msgObj, dests, curr_round, src_proc):
        src_vid = self.proc_to_uid[src_proc] % self.config['nvalidators']
        current_config = self.get_current_config(curr_round)
        current_partitions = current_config['partition']

        LOGGER.log_network_event(curr_round, msgType, [
                                 'from', self.proc_to_uid[src_proc], 'to', dests])

        src_partition = self.get_partition(
            current_partitions, self.proc_to_uid[src_proc])
        for dest_vid in dests:
            dest_procs = self.vid_to_proc[dest_vid]
            for dest_proc in dest_procs:
                dest_partition = self.get_partition(
                    current_partitions, self.proc_to_uid[dest_proc])
                if dest_partition == src_partition and not self.drop_message(current_config['msg_drops'][src_partition], src_vid, msgType, curr_round):
                    send((msgType, msgObj, src_vid), to=dest_proc)

    def is_committed_block_valid(block, tracker_block_command):
        return block.payload[0]['command'] == tracker_block_command

    def receive(msg=(msgType, msgObj, dests, curr_round), from_=src_proc):

        if msgType == 'CommitAck':
            return

        if curr_round > self.recent_committed_blocks_proposed_round + self.liveness_bound:
            output('LIVENESS VIOLATED!')
            LOGGER.log_network_event(curr_round, msgType, [
                                     'Liveness Violation detected!', 'No blocks are commited since blocks proposed in round', self.recent_committed_blocks_proposed_round])
            send(('Terminate',), to=parent())

        if curr_round < len(self.round_config):
            self.relay_msg(msgType, msgObj, dests, curr_round, src_proc)
        else:
            self.count_terminal_round_messages.add(
                self.proc_to_uid[src_proc] % self.config['nvalidators'])
            if len(self.count_terminal_round_messages) >= self.config['nvalidators']:
                LOGGER.log_network_event(curr_round, msgType, [
                                         'All rounds executed, sending terminate to test executer!'])
                send(('Terminate',), to=parent())

    def receive(msg=('CommitAck', idx, block, curr_round,), from_=src_proc):
        if idx not in self.commit_tracker:
            self.commit_tracker[idx] = [block.payload[0]['command']]
        else:
            if is_committed_block_valid(block, self.commit_tracker[idx][-1]):
                self.commit_tracker[idx].append(block.payload[0]['command'])
            else:
                output('SAFETY VIOLATED!')
                LOGGER.log_network_event(curr_round, 'CommitAck', [
                                         'Safety Violation detected!', 'Inconsistency in the transactions committed to ledger at index', idx])
                send(('Terminate',), to=parent())

        self.recent_committed_blocks_proposed_round = max(
            self.recent_committed_blocks_proposed_round, block.round)

    def is_committed_block_valid(block, tracker_block_command):
        return block.payload[0]['command'] == tracker_block_command

    def receive(msg=(msgType, sync_obj), from_=srcProc):
        src_vid = self.proc_to_uid[srcProc] % self.config['nvalidators']
        dest_vid = sync_obj['send_to']
        dest_procs = self.vid_to_proc[dest_vid]
        for dest_proc in dest_procs:
            if msgType.startswith('One_block_done') or msgType.startswith('Increment_done'):
                send((msgType), to=dest_proc)
            else:
                send((msgType, sync_obj), to=dest_proc)
