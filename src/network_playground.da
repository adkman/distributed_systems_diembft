class NetworkPlayground(process):
    def setup(config, round_config, proc_to_uid, vid_to_proc, liveness_bound):
        self.round_config = round_config
        self.proc_to_uid = proc_to_uid
        self.vid_to_proc = vid_to_proc
        self.count_terminal_round_messages = set()
        self.commit_tracker = dict()  # <round, commit_acks[]>
        self.recent_commit_round = None
        # liveness property is violated if there is no commit for proposal in liveness_bound number of rounds
        self.liveness_bound = liveness_bound
        self.config = config

    def run():
        print("WAITING for done")
        await(received(('Done',), from_=parent()))
        output('Exiting network playground')

    def get_current_config(curr_round):
        if curr_round < len(self.round_config):
            return self.round_config[curr_round]
        else:
            return {
                'partition': [[v for v in range(self.config['nvalidators'] + self.config['nfaulty'])]],
                'msg_drops': [[]],
                'Leader': 0,
            }

    def get_partition(current_partitions, uid):
        for idx in range(len(current_partitions)):
            if uid in current_partitions[idx]:
                return idx
        return None

    def drop_message(drop_configs, src_vid, msgType):
        for drop_config in drop_configs:
            if drop_config['msgType'] != 'WILDCARD' and drop_config['msgType'] != msgType:
                continue
            if drop_config['validator'] != 'WILDCARD' and drop_config['validator'] != src_vid:
                continue
            # print('DROPPING', src_vid, msgType)
            return True
        return False

    def relay_msg(msgType, msgObj, dests, curr_round, src_proc):
        src_vid = self.proc_to_uid[src_proc] % self.config['nvalidators']
        current_config = self.get_current_config(curr_round)
        current_partitions = current_config['partition']

        print('Round', curr_round, msgType, 'from', self.proc_to_uid[src_proc], 'to', dests, 'partitions', current_partitions)

        src_partition = self.get_partition(current_partitions, self.proc_to_uid[src_proc])
        for dest_vid in dests:
            dest_procs = self.vid_to_proc[dest_vid]
            for dest_proc in dest_procs:
                dest_partition = self.get_partition(
                    current_partitions, self.proc_to_uid[dest_proc])
                if dest_partition == src_partition and not self.drop_message(current_config['msg_drops'][src_partition], src_vid, msgType):
                    send((msgType, msgObj, src_vid), to=dest_proc)

    def receive(msg=(msgType, msgObj, dests, curr_round), from_=src_proc):

        self.relay_msg(msgType, msgObj, dests, curr_round, src_proc)

        # if curr_round > self.recent_commit_round + self.liveness_bound:
        #     send(('LivenessViolation'), to=parent())

        if curr_round > len(self.round_config):
            self.count_terminal_round_messages.add(self.proc_to_uid[src_proc]%self.config['nvalidators'])
            if len(self.count_terminal_round_messages) >= self.config['nvalidators']:
                print('SHOULD TERMINATE NOW')
                send(('Terminate',), to=parent())

    def receive(msg=('CommitAck', commitMsg, curr_round), from_=src_proc):
        output('CommitAck', commitMsg, curr_round, src_proc)
        # if curr_round not in self.commit_tracker:
