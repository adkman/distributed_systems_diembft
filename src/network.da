    #         commit_tracker[round].add(M)
    #     else
    #         send (‘SafetyViolation’, round, commit_tracker[round]) to executer
    #     end if
    # end if
    # if len(commit_tracker[round]) >= 2*number_of_twins + 1 then
    #     recent_commit_round = round
    # end if

    def receive(msg=('CommitAck', CommitAck_msg), from_=p):
        round = CommitAck.round #CHECK THIS (HOW TO ACCESS ROUND FROM THE RECEIVED MESSAGE)
        if round not in self.commit_tracker:
            self.commit_tracker[round] = []
        else:
            # TODO: define is_commited_block_valid funtion
            if is_committed_block_valid(M.committed_block, commit_tracker[round][-1]):
                self.commit_tracker[round].append()
            else:
                send(('SafetyViolation', round, self.commit_tracker), to=self.executor)

        if len(self.commit_tracker[round]) >= 2*config['nfaulty']+1:
            self.recent_commit_round = round

    # TODO: Need to execute this whole handeling of else block
    def receive(msg=('message', M, ''' all other needed parameters'''), from_=src_proc):
        self.relay_msg(M,src_proc)
        if M.round > self.recent_commit_round+self.liveness_bound:
            send(('Liveness Violation'), to= self.executor)

        if M.round == len(self.round_config):
            self.count_terminal_round_messages.add(self.proc_to_vid[src_proc])
            if len(self.count_terminal_round_messages) == self.config['nvalidators']:
                send(('Terminate'), to=self.executor)
