class NetworkPlayground(process):
    def setup(scenario, config, proc_to_vid, vid_to_proc, liveness_bound, executor):
        self.round_config = scenario
        self.proc_to_vid = proc_to_vid
        self.vid_to_proc = vid_to_proc
        self.count_terminal_round_messages = set()
        self.commit_tracker = dict() # <round, commit_acks[]>
        self.recent_commit_round = None
        self.liveness_bound = liveness_bound # liveness property is violated if there is no commit for proposal in liveness_bound number of rounds
        self.executor = executor
        self.config = config
        
#Event listener: wait for a Message M from src_proc
