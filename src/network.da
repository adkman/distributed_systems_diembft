# Procedure relay_msg(M, src_proc)
#     current_partitions ← round_config[M.round].partitions
#     src_partition ← get_partition(current_partitions, src_proc)
#     for dest_vid in M.dests do // Handles message sent to multiple destinations
#         dest_procs ← vid_to_proc[dest_vid]
#         for dest_proc in dest_procs do // Handles msg is sent to twin
#             dest_partition ← get_partition(current_partitions, dest_proc)
#             if dest_partition = src_partition and !drop_message(round, src_proc, 
#                                                                 M.msgType) then
#                 M.from ← proc_to_vid[src_proc]
#                 send M to dest_proc
#            end if
#         done
#     done

    def relay_msg(self,M,src_proc):
        current_partitions = self.round_config[M.round]['partition']
        src_partition = self.get_partition(current_partitions, src_proc)
        for dest_vid in M.dests:
            dest_procs = self.vid_to_proc[dest_vid]
            for dest_proc in dest_procs:
                dest_partition = self.get_partition(current_partitions, dest_proc)
                if dest_partition == src_partition and not(self.drop_message(round, src_proc, M.msgType)):
                    M.src = proc_to_vid[src_proc]
                    # TODO: need to align send accordingly 
                    send((M.type,M), to = dest_proc)
    # Function get_partition(current_partitions, proc)
    #     for idx in |current_partitions| do
    #         if proc in current_partitions[idx] then
    #             return idx
    #         end if
    #     done
    #     return ⊥

    def get_partition(self, current_partitions, proc):
        for idx in len(current_partitions):
            if proc in current_partitions[idx]:
                return idx
        
        return None


