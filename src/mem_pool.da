from logger_util import LOGGER


class MemPool:

    def __init__(self, uniq_vid, pacemaker):
        self.pacemaker = pacemaker
        self.uniq_vid = uniq_vid

    '''Function get transactions()'''

    def get_transactions(self):
        LOGGER.log('MemPool: get_transactions', None)
        txn = {
            'req_id': str(self.uniq_vid) + "_" + str(self.pacemaker.current_round),
            'command': str(self.uniq_vid) + "-" + str(self.pacemaker.current_round)
        }
        LOGGER.log('MemPool: get_transactions: returns', txn)
        return [txn]
