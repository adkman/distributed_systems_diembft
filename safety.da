from cryptography import Cryptography
from object_types import LedgerCommitInfo, TimeoutInfo, VoteInfo, VoteMsg
from logger_util import Logging


class Safety:

    # TODO: move private and public keys here
    def __init__(self, validator_id, replicas, ledger, blocktree):
        self.private_key = None
        self.public_keys = []
        self.highest_vote_round = 0
        self.highest_qc_round = 0 #have to check this
        self.validator_id = validator_id
        self.validator = replicas[validator_id]
        self.ledger = ledger
        self.blocktree = blocktree

    def increase_highest_vote_round(self, round):
        Logging.log("Safety: increase_highest_vote_round", round)
        self.highest_vote_round = max(round, self.highest_vote_round)
        Logging.log("Safety: increase_highest_vote_round returns", self.highest_vote_round)

    def update_highest_qc_round(self, qc_round):
        Logging.log("Safety: update_highest_qc_round", qc_round)
        self.highest_qc_round = max(qc_round, self.highest_qc_round)
        Logging.log("Safety: update_highest_qc_round returns", self.highest_qc_round)

    def consecutive(self, block_round, round):
        Logging.log("Safety: consecutive", block_round, round)
        Logging.log("Safety: consecutive returns", round + 1 == block_round)
        return round + 1 == block_round

    def safe_to_extend(self, block_round, qc_round, tc):
        if tc == None:
            tc_round = 0
        else:
            tc_round = tc.round
        Logging.log("Safety: safe_to_extend", block_round, qc_round, tc)
        Logging.log("Safety: safe_to_extend returns", self.consecutive(block_round, tc_round) and qc_round >= max(tc.tmo_high_qc_rounds))
        return self.consecutive(block_round, tc_round) and qc_round >= max(tc.tmo_high_qc_rounds)
        #This is modified

    def safe_to_vote(self, block_round, qc_round, tc):
        Logging.log("Safety: safe_to_vote", block_round, qc_round, tc)
        if block_round <= max(self.highest_vote_round, qc_round):
            Logging.log("Safety: safe_to_vote returns1", False)
            return False
        Logging.log("Safety: safe_to_vote returns2", self.consecutive(block_round, qc_round) or self.safe_to_extend(block_round, qc_round, tc))
        return self.consecutive(block_round, qc_round) or self.safe_to_extend(block_round, qc_round, tc)
        #here tc is being handled by safe_to_extend and qc_round will be 0 if it is None

    def safe_to_timeout(self, round, qc_round, tc):
        if tc == None:
            tc_round = 0
        else:
            tc_round = tc.round
        Logging.log("Safety: safe_to_timeout", round, qc_round, tc)
        if (qc_round < self.highest_qc_round) or (round <= max(self.highest_vote_round - 1, qc_round)):
            Logging.log("Safety: safe_to_timeout returns1", False)
            return False
        Logging.log("Safety: safe_to_timeout returns2", self.consecutive(round, qc_round) or self.consecutive(round, tc_round))
        return self.consecutive(round, qc_round) or self.consecutive(round, tc_round)
        # It would handle by itself

    def commit_state_id_candidate(self, block_round, qc_round, qc_block_id):
        Logging.log("Safety: commit_state_id_candidate", block_round, qc_round, qc_block_id)
        if self.consecutive(block_round, qc_round):
            Logging.log("Safety: commit_state_id_candidate returns1", self.ledger.pending_state(qc_block_id))
            return self.ledger.pending_state(qc_block_id)
        else:
            Logging.log("Safety: commit_state_id_candidate returns2", None)
            return None

    def set_highest_vote_round(self, value):
        self.highest_vote_round = value

    def make_vote(self, block, last_tc):
        Logging.log('Safety: make_vote', block, last_tc)
        if block.qc is None:
            qc_round = 0
            qc_block_id = "0"
        else:
            qc_round = block.qc.vote_info.round
            qc_block_id = block.qc.vote_info.id
        if Cryptography.valid_signatures(last_tc) and Cryptography.valid_signatures(block) and self.safe_to_vote(block.round, qc_round, last_tc):
            self.update_highest_qc_round(qc_round)
            self.increase_highest_vote_round(block.round)
            vote_info = VoteInfo(
                block.id,
                block.round,
                qc_block_id,
                qc_round,
                self.ledger.pending_state(block.id)
            )
            ledger_commit_info = LedgerCommitInfo(
                self.commit_state_id_candidate(block.round, qc_round, qc_block_id),
                Cryptography.hash(vote_info)
            )
            vote_msg = VoteMsg(
                vote_info,
                ledger_commit_info,
                self.blocktree.high_commit_qc,
                self.validator_id
            )
            Logging.log('Safety: make_vote: returns', vote_msg)
            return vote_msg
        Logging.log('Safety: make_vote: returns', None)
        return None

    def make_timeout(self, round, high_qc, last_tc):
        Logging.log('Safety: make_timeout', round, high_qc, last_tc)
        if high_qc is None:
            qc_round = 0
        else:
            qc_round = high_qc.vote_info.round
        # TODO implement valid_signatures and params for tmo_info
        if Cryptography.valid_signatures(high_qc) and Cryptography.valid_signatures(last_tc) and self.safe_to_timeout(round, qc_round, last_tc):
            tmo_info =  TimeoutInfo(
                round,
                high_qc,
                self.validator_id
            )
            Logging.log('Safety: make_timeout: returns1', tmo_info)
            return tmo_info
        Logging.log('Safety: make_timeout: returns2', None)
        return None
