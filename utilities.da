class VoteInfo:
    def __init__(self, id = None, round = None, parent_id = None, parent_round = None, exec_state_id = None):
        self.id = id 
        self.round = round # Id and round of block
        self.parent_id= parent_id
        self.parent_round = parent_round # Id and round of parent
        self.exec_state_id = exec_state_id # Speculated execution state

# speculated new committed state to vote directly on
class LedgerCommitInfo:
    def __init__(self, commit_state_id = None, vote_info_hash = None):
        self.commit_state_id = commit_state_id # ⊥ if no commit happens when this vote is aggregated to QC
        self.vote_info_hash = vote_info_hash # Hash of VoteMsg.vote info

class VoteMsg:
    def __init__(self, vote_info = None, ledger_commit_info = None, high_commit_qc = None, validator = None):
        self.vote_info = vote_info # A VoteInfo record  
        self.ledger_commit_info = ledger_commit_info # Speculated ledger info
        self.high_commit_qc = high_commit_qc # QC to synchronize on committed blocks
        self.sender = validator # Added automatically when constructed
        self.signature = signu(self.ledger_commit_info) # Signed automatically when constructed
        # self.signature = Cryptography.sign_message(self.ledger_commit_info,self.validator_private_key)

# QC is a VoteMsg with multiple signatures
class QC:
    def __init__(self, vote_info = None, ledger_commit_info = None,signatures = None, validator = None):
        self.vote_info = vote_info
        self.ledger_commit_info = ledger_commit_info
        self.signatures = signatures #A quorum of signatures
        self.author = validator # The validator that produced the qc
        self.author_signature = signu(self.signatures)
        # self.author_signature = Cryptography.sign_message(self.signatures,self.validator_private_key)

class Block:
    def __init__(self, author = None, round = None, payload = None, qc = None, id = None):
        self.author = author #The author of the block, may not be the same as qc.author after view-change
        self.round = round #Yhe round that generated this proposal
        self.payload = payload #Proposed transaction(s)
        self.qc = qc # QC for parent block
        self.id = id# A unique digest of author, round, payload, qc.vote info.id and qc.signatures

class TimeoutInfo:
    def __init__(self, round = None, high_qc = None, validator = None):
        self.round = round
        self.high_qc = high_qc
        self.sender = validator # Added automatically when constructed
        self.signature = signu(round, self.high_qc.round) # Signed automatically when constructed
        # self.signature = Cryptography.sign_message() TODO: find a way to sign when two arguments are passed

class TC:
    def __init__(self, round =None, tmo_high_qc_rounds =None, signatures =None):
        self.round = round # All timeout messages that form TC have the same round
        self.tmo_high_qc_rounds = tmo_high_qc_rounds # A vector of 2f + 1 high qc round numbers of timeout messages that form TC
        self.tmo_signatures = signatures # A vector of 2f + 1 validator signatures on (round, respective high qc round)

class TimeoutMsg:
    def __init__(self, tmo_info = None, last_round_tc = None, high_commit_qc = None):
        self.tmo_info = tmo_info # TimeoutInfo for some round with a high qc
        self.last_round_tc = last_round_tc # TC for tmo info.round − 1 if tmo info.high qc.round 6= tmo info.round − 1, else ⊥
        self.high_commit_qc = high_commit_qc # QC to synchronize on committed blocks

class ProposalMsg:
    def __init__(self, block = None, last_round_tc = None, high_commit_qc = None):
        self.block = block
        self.last_round_tc = last_round_tc # TC for block.round − 1 if block.qc.vote info.round 6= block.round − 1, else ⊥
        self.high_commit_qc = high_commit_qc # QC to synchronize on committed blocks
        self.signature =  signu(self.block.id) # T
        # self.signature = Cryptography.sign_message(self.block_id,self.validator_private_key)