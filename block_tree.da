from cryptography import Cryptography
from object_types import QC, Block
from utils import get_qc_with_max_round


class BlockTree:
    def __init__(self, validator, ledger, nfaulty, block_block_id):
        self.pending_block_tree = []  # tree of blocks pending commitment
        # collected votes per block indexed by their LedgerInfo hash
        self.pending_votes = dict()
        self.high_qc = None  # highest known QC
        self.high_commit_qc = None  # highest QC that serves as a commit certificate
        self.validator = validator
        self.ledger = ledger
        self.f = nfaulty

    def execute_and_insert(self, block):
        self.ledger.speculate(block.qc.vote_info.id, block.id, block.payload)
        self.pending_block_tree.add(block)

    def generate_block(self, txns, current_round):
        qc = self.high_qc
        return Block(
            self.validator,
            current_round,
            txns,
            self.high_qc,
            Cryptography.hash(self.validator, current_round,
                              txns, qc.vote_info.id, qc.signatures)
        )

    def process_vote(self, vote_msg):
        self.process_qc(vote_msg.high_commit_qc)
        vote_idx = Cryptography.hash(vote_msg.ledger_commit_info)
        self.pending_votes[vote_idx] = self.pending_votes[vote_idx].add(
            vote_msg.signature)
        if len(self.pending_votes[vote_idx]) == 2*self.f + 1:
            return QC(
                vote_info=vote_msg.vote_info,
                ledger_commit_info=vote_msg.ledger_commit_info,
                votes=self.pending_votes[vote_idx],
                validator=self.validator
            )
        # This is the structure of QC
        # self.vote_info = vote_info
        # self.ledger_commit_info = ledger_commit_info # It had ledger_commit_state_id and hash of vote info
        # self.signatures = signatures # A quorum of signatures
        # self.author = validator # The validator that produced the qc ----- Is this the leader of the block
        # self.author_signature = signu(self.signatures)
        return None

    def process_qc(self, qc):
        if qc.ledger_commit_info.commit_state_id != None:
            self.ledger.commit(qc.vote_info.parent_id)
            self.pending_block_tree.prune(qc.vote_info.parent_id)
            self.high_commit_qc = get_qc_with_max_round(
                qc, self.high_commit_qc)
        self.high_qc = get_qc_with_max_round(qc, self.high_qc)
