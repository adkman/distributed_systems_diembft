import nacl.signing
import nacl.encoding
import pickle
import nacl.hash


class Cryptography:
    def hash(*data):
        return nacl.hash.sha256(pickle.dumps(data), encoder=nacl.encoding.HexEncoder)

    def generate_key():
        signing_key = nacl.signing.SigningKey.generate()
        verification_key = signing_key.verify_key
        return (signing_key, verification_key)

    def sign_message(message):
        return Cryptography.private_key.sign(Cryptography.get_bytes_from_data(message))
 
    def get_bytes_from_data(message):
        return pickle.dumps(message)

    def get_data_from_bytes(message):
        return pickle.loads(message)

    def get_verified_message(signed_message, public_key):
        try:
            bytes_data = public_key.verify(signed_message)
            return Cryptography.get_data_from_bytes(bytes_data)
        except:
            return None

    def valid_signatures(messages):
        all_signatures_valid = True
        for message in messages:
            if message is None:
                is_signature_valid = True
            else:
                print(hasattr(message, 'tmo_info'))
                if hasattr(message, 'tmo_info'):
                    is_signature_valid = Cryptography.valid_signature(message.tmo_info)
                else:
                    is_signature_valid = Cryptography.valid_signature(message)
            all_signatures_valid = all_signatures_valid and is_signature_valid
        return all_signatures_valid

    #Message Type is Block, QC, TC
    def valid_signature(message):
        signature = Cryptography.get_verified_message(message.author_signature, Cryptography.public_keys_validators[Cryptography.replicas[message.author]])
        return signature is not None