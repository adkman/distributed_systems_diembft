import time

from cryptography import Cryptography
from logger_util import Logging

class Client(process):

    def setup(config, client_id, validators: list, private_key, public_keys_validators):
        self.pending_success_results = dict()
        self.pending_fail_results = dict()
        self.final_results = set()
        self.sleep_time = config['sleeptime']
        self.nops = config['nclientops']
        self.f = config['nfaulty']
        Cryptography.private_key = self.private_key

        Logging.replicas = validators
        Logging.process_type = "Client"
        Logging.process_id = client_id

    def run():
        for i in range(nops):
            pending_success_results[i] = list()
            pending_fail_results[i] = list()
            req = {
                'req_id': i,
                'command': str(client_id) + "-" + str(i)
            }
            signed_req = Cryptography.sign_message(req)
            send(('request', signed_req), to=validators)
            await(i in final_results)
            output('Got final response for request', req)
            time.sleep(sleep_time)

        send(('Done',), to=parent())

    def receive(msg=('response', resp), from_=validator):
        output("got response", resp)
        req_id = resp['req_id']
        resp_status = resp['resp_status']
        if resp_status == "success":
            pending_success_results[req_id].append(resp)
            if len(pending_success_results[req_id]) == self.f + 1:
                final_results.add(req_id)
                output("The transaction succeeded")
        else:
            pending_fail_results[req_id].append(resp)
            if len(pending_fail_results[req_id]) == self.f + 1:
                final_results.add(req_id)
                output("The transaction failed")
