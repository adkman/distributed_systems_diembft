import time
from cryptography import Cryptography
class Client(process):

    def setup(validators: set, nops: int, private_key, public_keys_validators):
        self.results = dict()
        self.final_results = set()
        self.sleep_time = 1

    def run():
        for i in range(nops):
            results[i] = []
            req = {
                'req_id': i,
                'request': "txn"
            }
            signed_req = Cryptography.sign_message(req, private_key)
            send(('request', signed_req), to=validators)
            await(i in final_results)
            output('Got final response')
            time.sleep(sleep_time)

        send(('Done',), to=parent())


    def receive(msg=('response', resp)):
        output("got response", resp)
        results[resp['req_id']].append(resp)
        resp_cert = True
        # check if f + 1 identical in results for request_id
        if resp_cert:
            final_results.add(resp['req_id'])



