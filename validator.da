from block_tree import BlockTree
from cryptography import Cryptography
from leader_election import LeaderElection
from ledger import Ledger
from mem_pool import MemPool
from object_types import ProposalMsg
from pacemaker import Pacemaker
from safety import Safety


class Validator (process):

    def setup(config, this_validator_id, this_validator, replicas: set, private_key, public_keys_validators, public_keys_clients):
        self.block_block_id = dict()
        self.ledger = Ledger(
            this_validator_id, this_validator, self.block_block_id)
        self.blocktree = BlockTree(
            this_validator, self.ledger, config['nfaulty'], self.block_block_id)
        self.safety = Safety(this_validator, self.ledger, self.blocktree)
        self.pacemaker = Pacemaker(
            this_validator, self.blocktree, self.safety, config['nfaulty'], config['delta'])
        self.mempool = MemPool()
        self.leader_election = LeaderElection(
            this_validator, replicas, self.ledger, self.pacemaker, config['window_size'], config['exclude_size'])
        Cryptography.private_key = self.private_key

    def run():
        await(received(('Done',), from_=parent()))

    def process_certificate_qc(qc):
        self.blocktree.process_qc(qc)
        self.leader_election.update_leaders(qc)
        self.pacemaker.advance_round_qc(qc)

    def process_new_round_event(last_tc):
        if self.this_validator == self.leader_election.get_leader(self.pacemaker.current_round):
            block = self.blocktree.generate_block(
                self.mempool.get_transactions(), self.pacemaker.current_round)
            proposal_msg = ProposalMsg(
                block=block,
                last_round_tc=last_tc,
                high_commit_qc=self.blocktree.high_commit_qc,
                validator=self.this_validator
            )
            signed_proposal_msg = Cryptography.sign_message(proposal_msg)
            send(('ProposalMsg', signed_proposal_msg), to=self.replicas)

    def receive(msg=('LocalTimeout',)):
        self.pacemaker.local_timeout_round()

    def receive(msg=('ProposalMsg', signed_proposal_msg), from_=p):
        proposal_msg = Cryptography.get_verified_message(
            signed_proposal_msg, public_keys_validators[p])
        if proposal_msg is not None:
            if proposal_msg.block.qc is not None:
                process_certificate_qc(proposal_msg.block.qc)
            if proposal_msg.high_commit_qc is not None:
                process_certificate_qc(proposal_msg.high_commit_qc)
            self.pacemaker.advance_round_tc(proposal_msg.last_round_tc)
            round = self.pacemaker.current_round
            leader = self.leader_election.get_leader(round)
            if proposal_msg.block.round != round or proposal_msg.sender != leader or proposal_msg.block.author != leader:
                return
            self.blocktree.execute_and_insert(proposal_msg.block)
            vote_msg = self.safety.make_vote(
                proposal_msg.block, proposal_msg.last_round_tc)
            if vote_msg is not None:
                signed_vote_msg = Cryptography.sign_message(vote_msg)
                send(('VoteMsg', signed_vote_msg),
                     to=self.leader_election.get_leader(round + 1))
        else:
            # TODO: Add mechanism to handle this
            output(p, "'s ProposalMsg signature could not be verified")

    def receive(msg=('VoteMsg', signed_vote_msg), from_=p):
        vote_msg = Cryptography.get_verified_message(
            signed_vote_msg, public_keys_validators[p])
        if vote_msg is not None:
            output("Recieved vote", vote_msg, "from ", p)
            qc = self.blocktree.process_vote(vote_msg)
            if qc is not None:
                process_certificate_qc(qc)
                process_new_round_event(None)
        else:
            # TODO: Add mechanism to handle this
            output(p, "'s VoteMsg signature could not be verified")

    def receive(msg=('TimeoutMsg', signed_timeout_msg), from_=p):
        timeout_msg = Cryptography.get_verified_message(
            signed_timeout_msg, public_keys_validators[p])
        if timeout_msg is not None:
            process_certificate_qc(timeout_msg.tmo_info.high_qc)
            process_certificate_qc(timeout_msg.high_commit_qc)
            self.pacemaker.advance_round_tc(timeout_msg.last_round_tc)
            tc = self.pacemaker.process_remote_timeout(timeout_msg)
            if tc is not None:
                self.pacemaker.advance_round_tc(tc)
                process_new_round_event(tc)
        else:
            # TODO: Add mechanism to handle this
            output(p, "'s TimeoutMsg signature could not be verified")

    def receive(msg=('request', signed_req), from_=client):

        req = Cryptography.get_verified_message(
            signed_req, public_keys_clients[client])
        if req is not None:
            # output("Verified", client, "'s signature")
            output("received request from client", req)

            req['client'] = client
            self.mempool.add_transaction(req)

            process_new_round_event(None)

            # req['resp_status'] = "success"
            # send(('response', req), to=client)
        else:
            # TODO: Add mechanism to handle this, send something to client
            output(client, "'s signature could not be verified")
