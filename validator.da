from block_tree import BlockTree
from cryptography import Cryptography
from leader_election import LeaderElection
from ledger import Ledger
from logger_util import Logging
from mem_pool import MemPool
from object_types import ProposalMsg
from pacemaker import Pacemaker
from safety import Safety


class Validator (process):

    def setup(config, validator_id, replicas: list, clients: list, private_key, public_keys_validators, public_keys_clients):
        self.id_block = dict()
        self.ledger = Ledger(
            validator_id, self.id_block)
        self.blocktree = BlockTree(
            validator_id, replicas, self.ledger, config['nfaulty'], self.id_block)
        self.safety = Safety(validator_id, replicas,
                             self.ledger, self.blocktree)
        self.pacemaker = Pacemaker(
            validator_id, replicas, self.blocktree, self.safety, config['nfaulty'], config['delta'])
        self.mempool = MemPool(validator_id)
        self.leader_election = LeaderElection(
            validator_id, replicas, self.ledger, self.pacemaker, config['window_size'], config['exclude_size'])
        Cryptography.private_key = self.private_key

        Logging.replicas = replicas
        Logging.process_type = "Validator"
        Logging.process_id = validator_id
        Logging.clients = clients

        Logging.filename = './logs/' + Logging.process_type + \
            "_" + str(Logging.process_id) + ".log"
        f = open(Logging.filename, 'w')
        f.close()
        self.can_execute_command = True

    def run():
        Logging.log(replicas[validator_id])
        await(received(('Done',), from_=parent()))

    def process_certificate_qc(qc):
        Logging.log('Validator: process_certificate_qc', qc)
        self.blocktree.process_qc(qc)
        self.leader_election.update_leaders(qc)
        self.pacemaker.advance_round_qc(qc)
        Logging.log('Validator: process_certificate_qc ended', qc)

    def process_new_round_event(last_tc):
        Logging.log('Validator: process_new_round_event', last_tc)
        if self.replicas[validator_id] == self.leader_election.get_leader(self.pacemaker.current_round):
            if self.mempool.peek_pool() == 0:
                prev_block = self.id_block[self.blocktree.high_qc.vote_info.id]
                prev_block_txn_len = len(prev_block.payload)
                prev_qc = prev_block.qc
                if prev_qc is not None:
                    prev_prev_block = self.id_block[prev_qc.vote_info.id]
                    prev_prev_block_txn_len = len(prev_prev_block.payload)
                else:
                    prev_prev_block_txn_len = 0

                if prev_block_txn_len == 0 and prev_prev_block_txn_len == 0:
                    Logging.log(
                        'Validator: process_new_round_event: returned as no transactions in mempool', last_tc)
                    return

            block = self.blocktree.generate_block(
                self.mempool.get_transactions(), self.pacemaker.current_round)

            proposal_msg = ProposalMsg(
                block=block,
                last_round_tc=last_tc,
                high_commit_qc=self.blocktree.high_commit_qc,
                validator=validator_id
            )
            # signed_proposal_msg = Cryptography.sign_message(proposal_msg)
            # send(('ProposalMsg', signed_proposal_msg), to=self.replicas)
            send(('ProposalMsg', proposal_msg), to=self.replicas)
            Logging.log_event("Sent", "ProposalMsg",
                              proposal_msg, self.replicas)
        Logging.log("Validator: process_new_round_event ends", None)

    def receive(msg=('LocalTimeout',), from_=p):
        Logging.log_event("Received", "LocalTimeout", None, p)
        self.pacemaker.local_timeout_round()


    # def receive(msg=('ProposalMsg', signed_proposal_msg), from_=p):
    def receive(msg=('ProposalMsg', proposal_msg), from_=p):
        Logging.log("Receving ProposalMsg", None)
        # proposal_msg = Cryptography.get_verified_message(
        #     signed_proposal_msg, public_keys_validators[p])
        # output("Received proposal from ", p, proposal_msg)
        Logging.log_event("Received", "ProposalMsg", proposal_msg, p)
        if proposal_msg is not None:
            self.can_execute_command = False
            if proposal_msg.block.qc is not None and p != replicas[validator_id]:
                process_certificate_qc(proposal_msg.block.qc)
            if proposal_msg.high_commit_qc is not None:
                process_certificate_qc(proposal_msg.high_commit_qc)
            self.pacemaker.advance_round_tc(proposal_msg.last_round_tc)
            round = self.pacemaker.current_round
            leader = self.leader_election.get_leader(round)
            if proposal_msg.block.round != round or replicas[proposal_msg.sender] != leader or replicas[proposal_msg.block.author] != leader:
                return
            if p != replicas[validator_id]:
                # Validate the transactions in current mempool with the received txns
                if not self.mempool.validate_and_remove_transactions(proposal_msg.block.payload):
                    Logging.log("Not processing the Proposal message as transactions are not valid", None)
                    return

            self.blocktree.execute_and_insert(proposal_msg.block)
            vote_msg = self.safety.make_vote(
                proposal_msg.block, proposal_msg.last_round_tc)
            if vote_msg is not None:
                # signed_vote_msg = Cryptography.sign_message(vote_msg)
                next_leader = self.leader_election.get_leader(round + 1)
                # send(('VoteMsg', signed_vote_msg),
                #      to=next_leader)
                Logging.log("Problem here?",None)
                Logging.log("VoteMsg",vote_msg)
                Logging.log("Leader", next_leader)
                send(('VoteMsg', vote_msg),
                     to=next_leader)

                Logging.log_event("Sent", "VoteMsg", vote_msg, next_leader)
        else:
            # TODO: Add mechanism to handle this
            output(p, "'s ProposalMsg signature could not be verified")
        

    # def receive(msg=('VoteMsg', signed_vote_msg), from_=p):
    def receive(msg=('VoteMsg', vote_msg), from_=p):
        # vote_msg = Cryptography.get_verified_message(
        #     signed_vote_msg, public_keys_validators[p])
        Logging.log_event("Received", "VoteMsg", vote_msg, p)
        if vote_msg is not None:
            qc = self.blocktree.process_vote(vote_msg)
            if qc is not None:
                process_certificate_qc(qc)
                process_new_round_event(None)

        else:
            # TODO: Add mechanism to handle this
            output(p, "'s VoteMsg signature could not be verified")
        Logging.log("Received VoteMsg ends g", None)

    # def receive(msg=('TimeoutMsg', signed_timeout_msg), from_=p):
    def receive(msg=('TimeoutMsg', timeout_msg), from_=p):
        Logging.log("Receving TimeoutMsg", None)
        # timeout_msg = Cryptography.get_verified_message(
        #     signed_timeout_msg, public_keys_validators[p])
        Logging.log_event("Received", "TimeoutMsg", timeout_msg, p)
        if timeout_msg is not None:
            process_certificate_qc(timeout_msg.tmo_info.high_qc)
            process_certificate_qc(timeout_msg.high_commit_qc)
            self.pacemaker.advance_round_tc(timeout_msg.last_round_tc)
            tc = self.pacemaker.process_remote_timeout(timeout_msg)
            if tc is not None:
                self.pacemaker.advance_round_tc(tc)
                process_new_round_event(tc)
        else:
            # TODO: Add mechanism to handle this
            output(p, "'s TimeoutMsg signature could not be verified")

    def receive(msg=('request', signed_req), from_=client):
        Logging.log("Receving Request", None)

        req = Cryptography.get_verified_message(
            signed_req, public_keys_clients[client])
        Logging.log_event("Received", "request", req, client)
        if req is not None:
            # output("Verified", client, "'s signature")
            # output("received request from client", req)

            req['client'] = client
            self.mempool.add_transaction(req)

            # process_new_round_event(None)
            if self.can_execute_command:
                process_new_round_event(None)
                self.can_execute_command = False

            # req['resp_status'] = "success"
            # send(('response', req), to=client)
        else:
            # TODO: Add mechanism to handle this, send something to client
            output(client, "'s signature could not be verified")
