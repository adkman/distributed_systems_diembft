class EventLoop (process):

    def setup(validator_id : int, validators_set : set):
        self.validators = list(validators_set)
        output('setup of eventLoop', validator_id, validators)


    def run():
        if validator_id != 0:
            for v in range(len(self.validators)):
                if v != 0:
                    output("Sending vote to leader ", self.validators[0], " from ", self.validator_id)
                    send(('VoteMsg', "vote"), to=self.validators[0])
        else:
            send(('Ack',), to=self.validators[0])
        await(received(('Done',), from_=parent()))

    def receive(msg=('VoteMsg', param), from_=voter):
        output("Received vote from ", voter, param)
        output("Sending Ack to voter", voter)
        send(('Ack',), to=voter)

    def receive(msg=('Ack',), from_=leader):
        output("Received ack from leader ", leader)
        send(('Done',), to=parent())

def main():
    # get config from config file
    nvalidators = 5
    nclients = 2
    nfaultyvalidators = 1
    # config

    validators = new(EventLoop, num= nvalidators)
    for i, v in enumerate(validators): setup({v}, (i, validators))

    start(validators)
    await(each(v in validators, has=received(('Done',), from_=v)))
    output("All validators done.")
    send(('Done',), to=validators)


