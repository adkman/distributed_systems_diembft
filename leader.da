from pacemaker import Pacemaker
from ledger import Ledger
class LeaderElection:

    def __init__(self):
        validators = [] # The list of current validators
        # do we have to explicitly state the window_size and exclude_size
        window_size = 5 # A parameter for the leader reputation algorithm
        exclude_size = 5 # Between f and 2f, number of excluded authors of last committed blocks

        reputation_leaders = dict() # Map from round numbers to leaders elected due to the reputation scheme

    def get_leader(self,round):
        if round in self.reputation_leaders:
            return self.reputation_leaders[round]
            #return leader // Reputation-based leader
        return self.validators[((round)//2)%len(self.validators)]

    def update_leaders(self,qc):
        extended_round  = qc.vote_info.parent_round
        qc_round = qc.vote_info.round
        current_round = Pacemaker.current_round
        if extended_round + 1 == qc_round and qc_round + 1 == current_round :
            self.reputation_leaders[current_round + 1] = self.elect_reputation_leader(qc)

    def elect_reputation_leader(self,qc):
        active_validators = set()  # ∅ // validators that signed the last window size committed blocks
        last_authors = set() # ∅ // ordered set of authors of last exclude size committed blocks
        current_qc = qc
        #for i = 0; i < window size ∨ |last authors| < exclude size; i ← i + 1 do
        i = 0
        while(i<self.window_size or len(last_authors)<self.exclude_size):
            current_block = Ledger.committed_block(current_qc.vote_info.parent_id)
            block_author = current_block.author
            if i < self.window_size:
                active_validators = active_validators.union(current_qc.signatures.signers())
            # |current qc.signatures.signers()| ≥ 2f + 1
            if len(last_authors) < self.exclude_size:
                last_authors = last_authors.union(block_author)
            current_qc = current_block.qc
            # active validators ← active validators \ last authors // contains at least 1 validator
        active_validators = active_validators.difference(last_authors) # contains at least 1 validator

        #Do we have to define the pick_one function
        return active_validators.pick_one(seed = qc.voteinfo.round)



